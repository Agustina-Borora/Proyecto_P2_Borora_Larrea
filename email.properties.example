# Copiá este archivo como "email.properties" (mismo nombre, sin ".example")
# en la raíz del proyecto, y completá tus datos reales ahí. "email.properties"
# está en .gitignore a propósito: nunca se sube al repositorio, así tu
# contraseña de aplicación no queda expuesta en GitHub.

# --- Configuración para Gmail ---
# 1. Entrá a https://myaccount.google.com/security con la cuenta de Gmail
#    que va a mandar los correos (puede ser una que crees para el proyecto).
# 2. Activá la "Verificación en dos pasos" (si todavía no la tenías).
# 3. Buscá "Contraseñas de aplicaciones" (App Passwords) y generá una nueva,
#    eligiendo "Correo" / "Otra (nombre personalizado)" -> "Laboratorio_LB".
#    Google te va a dar un código de 16 caracteres: ESA es smtp.password,
#    NO la contraseña real de tu cuenta de Gmail.

smtp.host=smtp.gmail.com
smtp.port=587
smtp.user=tu.cuenta@gmail.com
smtp.password=contraseña-de-aplicacion-de-16-caracteres
smtp.from=tu.cuenta@gmail.com

# --- Si usás otro proveedor (Outlook, tu propio servidor SMTP, etc.) ---
# Cambiá smtp.host/smtp.port por los que te indique tu proveedor, y
# smtp.user/smtp.password por tus credenciales de ese servicio.
